diff --git a/drivers/mmc/core/lumia930-audit.h b/drivers/mmc/core/lumia930-audit.h
new file mode 100644
--- /dev/null
+++ b/drivers/mmc/core/lumia930-audit.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LUMIA930_MMC_AUDIT_H
+#define LUMIA930_MMC_AUDIT_H
+
+#include <linux/mmc/mmc.h>
+
+static inline bool lumia930_mmc_audit_allowed(unsigned int opcode,
+		unsigned int arg, bool data_write)
+{
+	unsigned int index = (arg >> 16) & 255;
+	unsigned int value = (arg >> 8) & 255;
+
+	if (data_write)
+		return false;
+
+	switch (opcode) {
+	case MMC_GO_IDLE_STATE:
+	case MMC_SEND_OP_COND:
+	case MMC_ALL_SEND_CID:
+	case MMC_SET_RELATIVE_ADDR:
+	case MMC_SELECT_CARD:
+	case MMC_SEND_EXT_CSD:
+	case MMC_SEND_CSD:
+	case MMC_SEND_CID:
+	case MMC_STOP_TRANSMISSION:
+	case MMC_SEND_STATUS:
+	case MMC_SET_BLOCKLEN:
+	case MMC_READ_SINGLE_BLOCK:
+	case MMC_READ_MULTIPLE_BLOCK:
+	case MMC_SEND_TUNING_BLOCK_HS200:
+	case MMC_SET_BLOCK_COUNT:
+		return true;
+	case MMC_SWITCH:
+		if ((arg >> 24) != MMC_SWITCH_MODE_WRITE_BYTE ||
+		    (arg & 255) != EXT_CSD_CMD_SET_NORMAL)
+			return false;
+		switch (index) {
+		case EXT_CSD_BUS_WIDTH:
+			return value <= 2;
+		case EXT_CSD_HS_TIMING:
+			return value <= 1;
+		case EXT_CSD_POWER_CLASS:
+			return value <= 15;
+		case EXT_CSD_ERASE_GROUP_DEF:
+		case EXT_CSD_POWER_OFF_NOTIFICATION:
+		case EXT_CSD_HPI_MGMT:
+			return value == 1;
+		default:
+			return false;
+		}
+	default:
+		return false;
+	}
+}
+
+#endif
